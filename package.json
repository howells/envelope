{
  "name": "@howells/envelope",
  "version": "0.7.0",
  "private": false,
  "description": "Strict Zod IO wrapper around local CLI LLMs (Claude Code, Codex, Gemini), plus an AI SDK adapter.",
  "keywords": [
    "ai-sdk",
    "claude",
    "cli",
    "codex",
    "gemini",
    "llm",
    "zod"
  ],
  "homepage": "https://github.com/howells/envelope#readme",
  "bugs": {
    "url": "https://github.com/howells/envelope/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/envelope.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "turbo run dev --filter=@howells/envelope-playground",
    "lint": "howells-check src",
    "lint:fix": "howells-fix src",
    "lint:ratchet": "node scripts/check-lint-baseline.mjs",
    "prepack": "pnpm build",
    "prepare": "howells-husky",
    "prepush": "pnpm typecheck && pnpm lint:ratchet && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10"
  },
  "devDependencies": {
    "@howells/husky": "^0.2.5",
    "@howells/lint": "^3.3.2",
    "@howells/typescript-config": "^0.1.2",
    "@types/node": "^25.6.0",
    "lint-staged": "^16.4.0",
    "turbo": "2.9.7",
    "typescript": "7.0.2",
    "vitest": "^4.1.5",
    "zod": "^4.4.2"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0"
}
